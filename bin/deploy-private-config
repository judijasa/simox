#!/usr/bin/env bash
# deploy-private-config — ship simox's private deploy.conf and reuter.ini
# (whole) to the stable per-app private-config dir on each [prod] host.
#
# Runs on the deploy machine (which has git and the `.private-source` pointer),
# as one step of the deploy pipeline: bin/deploy.sh runs it before the framework
# `pf-deploy.sh`, whose DEPLOY_PRE_PROVISION_CMD hook
# (bin/deploy/inject-private-config.sh) copies the two files into the freshly
# swapped etc/ on the host.
#
# Both files ship WHOLE (no inner filtering, no reuter.ini section splicing)
# from `git archive HEAD` of the private repo's checkout, so prod runs committed
# config only — never a dirty working tree or a loose git-ignored file. Nothing
# else leaves the deploy machine: machines.ini, team.ini, hosts and
# host-hardening.php are dev/deploy-time inputs.
#
# The private source is materialized first (bin/fetch-private-data, which is
# idempotent), so this CLI also works on its own, not only through bin/deploy.sh.
#
# Reads (from the repo root, same layout as pf-deploy.sh):
#   .private-source     PRIVATE_DATA_GIT (+ optional PRIVATE_DATA_REF) — the
#                       private config repo both shipped files come from.
#   etc/deploy.conf     DEPLOY_PRIVATE_CONFIG_DIR — the stable per-app private
#                       dir on each host. It MUST live OUTSIDE
#                       DEPLOY_TARGET_DIR, which is swapped on every deploy.
#   etc/machines.ini    the [prod] roster, read LOCALLY (never shipped).
#
# Usage: bin/deploy-private-config [target-host]   (default: every [prod] host)

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_ROOT"

# Materialize the private files locally (idempotent): the shipped content comes
# from the var/private-data checkout, DEPLOY_PRIVATE_CONFIG_DIR from
# etc/deploy.conf, and the roster from etc/machines.ini.
"$REPO_ROOT/bin/fetch-private-data" "$REPO_ROOT"

if [[ ! -f etc/deploy.conf ]]; then
    echo "deploy-private-config: etc/deploy.conf not found" >&2
    echo "  It is private data, materialized by bin/fetch-private-data from .private-source." >&2
    exit 1
fi
set -a
# shellcheck disable=SC1091
. ./etc/deploy.conf
set +a

if [[ -z "${DEPLOY_PRIVATE_CONFIG_DIR:-}" ]]; then
    echo "deploy-private-config: etc/deploy.conf sets no DEPLOY_PRIVATE_CONFIG_DIR (required)." >&2
    exit 1
fi

# Shared roster parser (the framework ships it to vendor/bin).
ROSTER_BIN="$REPO_ROOT/vendor/bin/pf-roster"
if [[ ! -x "$ROSTER_BIN" ]]; then
    echo "deploy-private-config: $ROSTER_BIN not found — run composer install." >&2
    exit 1
fi

# Committed content only: the private repo's HEAD must carry both files.
SOURCE_DIR="$REPO_ROOT/var/private-data"
SHIP_FILES=(deploy.conf reuter.ini)
for f in "${SHIP_FILES[@]}"; do
    if ! git -C "$SOURCE_DIR" cat-file -e "HEAD:$f" 2>/dev/null; then
        echo "deploy-private-config: the private repo has no tracked $f at HEAD." >&2
        exit 1
    fi
done

WANTED="${1:-}"

ship_to_host() {
    local HOST="$1"
    echo "    Shipping ${SHIP_FILES[*]} (whole) to $HOST:$DEPLOY_PRIVATE_CONFIG_DIR ..." >&2
    git -C "$SOURCE_DIR" archive HEAD "${SHIP_FILES[@]}" \
        | ssh "root@$HOST" "mkdir -p '$DEPLOY_PRIVATE_CONFIG_DIR' && tar -x -C '$DEPLOY_PRIVATE_CONFIG_DIR'"
}

main() {
    local host taglist found=0 count=0
    while IFS='=' read -r host taglist; do
        [[ -n "$host" ]] || continue
        count=$((count + 1))
        if [[ -n "$WANTED" ]]; then
            if [[ "$host" == "$WANTED" ]]; then
                found=1
                ship_to_host "$host"
                break
            fi
            continue
        fi
        ship_to_host "$host"
    done < <("$ROSTER_BIN" --list)

    if [[ -n "$WANTED" && "$found" -eq 0 ]]; then
        echo "deploy-private-config: host '$WANTED' is not in the [prod] roster of etc/machines.ini." >&2
        exit 1
    fi
    if [[ "$count" -eq 0 ]]; then
        echo "deploy-private-config: [prod] roster in etc/machines.ini is empty." >&2
        exit 1
    fi
}

main
