#!/usr/bin/env php
<?php

declare(strict_types=1);

// gen-service-users - simox service-account provisioning (consumer-owned).
//
// ema provisions the instance and schema (ema sandbox / ema create): it
// creates the database and applies schema packages, never users or grants.
// The service accounts are this repo's policy, so this script creates them:
//
//   admin   @ SERVERNAME   GRANT ALL PRIVILEGES ON <db>.*   (read-write app)
//   reader  @ SERVERNAME   GRANT SELECT ON <db>.*            (read-only app)
//   public  @ '%'          no database-level grant            (anonymous read;
//                             per-table SELECT grants live in pkg/, applied by ema)
//
// All three are passwordless (empty <ACCOUNT>_PASSWORD), matching the
// host-pinned model. SERVERNAME (default "localhost") is read from the [<db>]
// section; set it to the DB host's ZeroTier IP (or "%") there when the app
// servers reach the database over the overlay network.
//
// It emits transient SQL (never persisted) and, unless -n/--dry-run, applies
// it as root through "ema mariadb <db> < file.sql" (DBUSER=root; run as root
// on the DB host - root/unix_socket auth over the MYSQL_UNIX_PORT socket from
// the manual reuter.ini section). It does NOT write the <ACCOUNT>_PASSWORD
// keys into reuter.ini: that file is the manual source of truth, recorded by
// the operator (empty = passwordless).
//
// Usage: gen-service-users <db> [-n|--dry-run] [--help]

const HELP = <<<'TXT'
Usage: gen-service-users <db> [flags]

Create simox's service accounts (admin/reader/public) for one database and
apply their grants. The <ACCOUNT>_PASSWORD keys are NOT written back — the
manual reuter.ini [<db>] section is the source of truth.

  <db>              database name (the [<db>] section in reuter.ini).
  -n, --dry-run     print the SQL without applying it.
  -h, --help        show this help.
TXT;

const ACCOUNT_PRIVILEGES = array(
    'admin' => 'ALL PRIVILEGES',
    'reader' => 'SELECT',
);

function config_path(): string
{
    $override = getenv('REUTER_INI');
    if ($override !== false && $override !== '') {
        return $override;
    }
    return getcwd() . '/etc/reuter.ini';
}

function load_section(string $path, string $db): array
{
    $cnf = parse_ini_file($path, true, INI_SCANNER_RAW);
    if (!is_array($cnf) || !isset($cnf[$db]) || !is_array($cnf[$db])) {
        fwrite(STDERR, "gen-service-users: no [{$db}] section in {$path}" . PHP_EOL);
        exit(1);
    }
    return $cnf[$db];
}

function sql_quote(string $value): string
{
    return str_replace("'", "''", $value);
}

function build_sql(string $db, string $servername): string
{
    $sql = '-- gen-service-users for ' . $db . ' (transient; never persisted)' . PHP_EOL;
    $sql .= PHP_EOL . '-- Service accounts (passwordless, host-pinned)' . PHP_EOL;
    $sql .= "CREATE USER IF NOT EXISTS 'admin'@'" . sql_quote($servername) . "' IDENTIFIED BY '';" . PHP_EOL;
    $sql .= "CREATE USER IF NOT EXISTS 'reader'@'" . sql_quote($servername) . "' IDENTIFIED BY '';" . PHP_EOL;
    $sql .= "CREATE USER IF NOT EXISTS 'public'@'%' IDENTIFIED BY '';" . PHP_EOL;
    $sql .= PHP_EOL . '-- Database-level grants (public per-table SELECT grants live in pkg/, applied by ema)' . PHP_EOL;
    foreach (ACCOUNT_PRIVILEGES as $account => $privilege) {
        $sql .= 'GRANT ' . $privilege . ' ON ' . $db . ".* TO '" . $account . "'@'" . sql_quote($servername) . "';" . PHP_EOL;
    }
    return $sql;
}

function apply_sql(string $db, string $sql): int
{
    $tmp = tempnam(sys_get_temp_dir(), 'gen_service_users_');
    if ($tmp === false || file_put_contents($tmp, $sql) === false) {
        fwrite(STDERR, "gen-service-users: could not write the temporary SQL file" . PHP_EOL);
        return 1;
    }
    $root = getcwd();
    $ema = is_executable($root . '/vendor/bin/ema') ? $root . '/vendor/bin/ema' : 'ema';
    $cmd = 'DBUSER=root ' . escapeshellarg($ema) . ' mariadb ' . escapeshellarg($db) . ' < ' . escapeshellarg($tmp);
    passthru($cmd, $code);
    @unlink($tmp);
    return $code;
}

function main(array $argv): int
{
    $db = null;
    $dryRun = false;
    foreach (array_slice($argv, 1) as $arg) {
        if ($arg === '-n' || $arg === '--dry-run') {
            $dryRun = true;
        } elseif ($arg === '-h' || $arg === '--help') {
            fwrite(STDOUT, HELP);
            return 0;
        } elseif ($db === null) {
            $db = $arg;
        } else {
            fwrite(STDERR, "gen-service-users: unexpected argument: {$arg}" . PHP_EOL);
            return 1;
        }
    }
    if ($db === null) {
        fwrite(STDERR, "gen-service-users: missing <db> argument" . PHP_EOL);
        fwrite(STDERR, HELP);
        return 1;
    }

    $path = config_path();
    if (!is_file($path)) {
        fwrite(STDERR, "gen-service-users: {$path} not found (set REUTER_INI or run from the repo root)" . PHP_EOL);
        return 1;
    }
    $section = load_section($path, $db);
    $servername = (string) ($section['SERVERNAME'] ?? 'localhost');

    $sql = build_sql($db, $servername);
    fwrite(STDOUT, $sql);

    if ($dryRun) {
        fwrite(STDERR, "gen-service-users: dry-run; SQL printed, not applied" . PHP_EOL);
        return 0;
    }

    $code = apply_sql($db, $sql);
    if ($code !== 0) {
        return $code;
    }

    fwrite(STDOUT, 'gen-service-users: accounts created for ' . $db . '; reuter.ini keys are manual (not written)' . PHP_EOL);
    return 0;
}

exit(main($argv));
