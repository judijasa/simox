#!/usr/bin/env php
<?php

declare(strict_types=1);

// gen-service-users - reconcile simox's service accounts (consumer-owned).
//
// ema provisions instances and schema (ema sandbox / ema create): it creates
// databases and applies schema packages, never users or grants. Service
// accounts are this repo's policy, declared in etc/service-users.sql. This
// script reconciles the live MariaDB instances against that declaration:
//
//   - creates the declared accounts (passwordless, host-pinned) and applies
//     their per-database grants;
//   - drops stale accounts: the legacy admin/reader pair, accounts on a
//     database they are not declared for (e.g. public on simo0), and host
//     pins no longer in the current source set (revocation).
//
// Host-pin sources (see the @directives in etc/service-users.sql):
//   member  every IP value in etc/team.ini
//   worker  every etc/machines.ini [prod] host tagged `worker`
//   web     every etc/machines.ini [prod] host tagged `web`
//
// The `replication` transport account is not managed here: the replica
// bootstrap creates it on the primary (doc/system/replica-bootstrap.md).
//
// Each target database is reconciled by running the generated SQL as root
// through "ema mariadb <db> < file.sql" (DBUSER=root; run as root on the DB
// host - root/unix_socket auth over the MYSQL_UNIX_PORT socket from the
// manual reuter.ini section). It does NOT write <ACCOUNT>_PASSWORD keys into
// reuter.ini: that file is the manual source of truth (empty = passwordless).
//
// Usage: gen-service-users [db...] [-n|--dry-run] [--help]

const HELP = <<<'TXT'
Usage: gen-service-users [db...] [flags]

Reconcile simox's service accounts (simox/public) against etc/service-users.sql.
With no <db> arguments, every database named in the @db directives is
reconciled; pass one or more <db> names to reconcile only those (each must be
declared in etc/service-users.sql).

  -n, --dry-run     print the SQL without applying it.
  -h, --help        show this help.
TXT;

const SERVICE_USERS_FILE = 'etc/service-users.sql';
const LEGACY_ACCOUNTS = array('admin', 'reader');

function repo_file(string $path): string
{
    return getcwd() . '/' . $path;
}

function sql_quote(string $value): string
{
    return str_replace("'", "''", $value);
}

// Parse etc/service-users.sql @directives into:
//   name => array('hosts' => array<string>, 'dbs' => array<db, privilege>)
function parse_accounts(string $file): array
{
    $lines = file($file, FILE_IGNORE_NEW_LINES);
    if ($lines === false) {
        fwrite(STDERR, "gen-service-users: could not read {$file}" . PHP_EOL);
        exit(1);
    }
    $accounts = array();
    $current = null;
    foreach ($lines as $line) {
        $trimmed = ltrim($line);
        if (str_starts_with($trimmed, '--')) {
            $trimmed = ltrim(substr($trimmed, 2));
        }
        if (!str_starts_with($trimmed, '@')) {
            continue;
        }
        $fields = preg_split('/\s+/', trim($trimmed));
        if ($fields === false) {
            continue;
        }
        $directive = $fields[0] ?? '';
        if ($directive === '@account' && isset($fields[1])) {
            $current = $fields[1];
            $accounts[$current] = array('hosts' => array(), 'dbs' => array());
        } elseif ($directive === '@hosts' && $current !== null && isset($fields[1])) {
            foreach (explode(',', implode(' ', array_slice($fields, 1))) as $src) {
                $src = trim($src);
                if ($src !== '') {
                    $accounts[$current]['hosts'][] = $src;
                }
            }
        } elseif ($directive === '@db' && $current !== null && isset($fields[1], $fields[2])) {
            $accounts[$current]['dbs'][$fields[1]] = implode(' ', array_slice($fields, 2));
        }
    }
    if ($accounts === array()) {
        fwrite(STDERR, "gen-service-users: no @account blocks found in {$file}" . PHP_EOL);
        exit(1);
    }
    return $accounts;
}

// Every IP value in etc/team.ini (all keys except the member `subject`).
function member_hosts(string $path): array
{
    if (!is_file($path)) {
        return array();
    }
    $ini = parse_ini_file($path, true, INI_SCANNER_RAW);
    if (!is_array($ini)) {
        return array();
    }
    $hosts = array();
    foreach ($ini as $section) {
        if (!is_array($section)) {
            continue;
        }
        foreach ($section as $key => $value) {
            if (strtolower((string) $key) === 'subject') {
                continue;
            }
            if (is_string($value) && $value !== '') {
                $hosts[] = $value;
            }
        }
    }
    return array_values(array_unique($hosts));
}

// Host IPs in etc/machines.ini [prod] carrying the given bare tag.
function machine_tag_hosts(string $path, string $tag): array
{
    if (!is_file($path)) {
        return array();
    }
    $ini = parse_ini_file($path, true, INI_SCANNER_RAW);
    if (!is_array($ini) || !isset($ini['prod']) || !is_array($ini['prod'])) {
        return array();
    }
    $hosts = array();
    foreach ($ini['prod'] as $host => $value) {
        $tags = array_map('trim', explode(',', (string) $value));
        if (in_array($tag, $tags, true)) {
            $hosts[] = (string) $host;
        }
    }
    return array_values(array_unique($hosts));
}

// Resolve one account's host-pin sources into a concrete IP set.
function account_hosts(array $account, array $member, array $worker, array $web): array
{
    $hosts = array();
    foreach ($account['hosts'] as $src) {
        switch ($src) {
            case 'member':
                $hosts = array_merge($hosts, $member);
                break;
            case 'worker':
                $hosts = array_merge($hosts, $worker);
                break;
            case 'web':
                $hosts = array_merge($hosts, $web);
                break;
            default:
                fwrite(STDERR, "gen-service-users: unknown host source '{$src}'" . PHP_EOL);
                exit(1);
        }
    }
    return array_values(array_unique($hosts));
}

// desired[db][account] = privilege; accountHosts[account] = host list.
function build_desired(array $accounts, array $member, array $worker, array $web): array
{
    $desired = array();
    $accountHosts = array();
    foreach ($accounts as $name => $account) {
        $accountHosts[$name] = account_hosts($account, $member, $worker, $web);
        foreach ($account['dbs'] as $db => $privilege) {
            $desired[$db][$name] = $privilege;
        }
    }
    return array($desired, $accountHosts);
}

// Every account name the reconcile manages (declared + legacy), used to
// enumerate and drop stale accounts.
function scope_accounts(array $accounts): array
{
    return array_values(array_unique(array_merge(array_keys($accounts), LEGACY_ACCOUNTS)));
}

// Enumerate live simox/public/admin/reader accounts as "user@host" strings.
// Returns [] on failure (reconcile degrades to create-only and warns).
function existing_users(string $db, array $scope): array
{
    $root = getcwd();
    $ema = is_executable($root . '/vendor/bin/ema') ? $root . '/vendor/bin/ema' : 'ema';
    $list = "'" . implode("','", array_map('sql_quote', $scope)) . "'";
    $sql = 'SELECT CONCAT(User, 0x40, Host) FROM mysql.user WHERE User IN (' . $list . ')';
    $cmd = 'DBUSER=root ' . escapeshellarg($ema) . ' mariadb ' . escapeshellarg($db)
        . ' -N -e ' . escapeshellarg($sql) . ' 2>&1';
    exec($cmd, $out, $code);
    if ($code !== 0) {
        $detail = trim(implode(PHP_EOL, $out));
        fwrite(STDERR, "gen-service-users: warning: could not enumerate existing users for {$db}"
            . ($detail !== '' ? ": {$detail}" : '') . PHP_EOL);
        fwrite(STDERR, 'gen-service-users: continuing create-only (no stale-account drops)' . PHP_EOL);
        return array();
    }
    $users = array();
    foreach ($out as $line) {
        $line = trim((string) $line);
        if ($line !== '') {
            $users[] = $line;
        }
    }
    return $users;
}

function split_account_host(string $accountAtHost): array
{
    $pos = strpos($accountAtHost, '@');
    if ($pos === false) {
        return array($accountAtHost, '');
    }
    return array(substr($accountAtHost, 0, $pos), substr($accountAtHost, $pos + 1));
}

// desired[account] = privilege (accounts declared for this database only).
function build_sql(string $db, array $desired, array $accountHosts, array $existing): string
{
    $wanted = array();
    foreach ($desired as $account => $_privilege) {
        foreach ($accountHosts[$account] as $host) {
            $wanted[$account . '@' . $host] = true;
        }
    }

    $sql = '-- gen-service-users reconcile for ' . $db . ' (transient; never persisted)' . PHP_EOL;
    $sql .= PHP_EOL . '-- Drops (stale: legacy, wrong-db, or removed host pins)' . PHP_EOL;
    foreach ($existing as $accountAtHost) {
        if (isset($wanted[$accountAtHost])) {
            continue;
        }
        list($account, $host) = split_account_host($accountAtHost);
        $sql .= "DROP USER IF EXISTS '" . sql_quote($account) . "'@'" . sql_quote($host) . "';" . PHP_EOL;
    }

    $sql .= PHP_EOL . '-- Creates + grants (passwordless, host-pinned)' . PHP_EOL;
    foreach ($desired as $account => $privilege) {
        foreach ($accountHosts[$account] as $host) {
            $sql .= "CREATE USER IF NOT EXISTS '" . sql_quote($account) . "'@'" . sql_quote($host) . "' IDENTIFIED BY '';" . PHP_EOL;
            $sql .= 'GRANT ' . $privilege . ' ON ' . $db . ".* TO '" . sql_quote($account) . "'@'" . sql_quote($host) . "';" . PHP_EOL;
        }
    }
    return $sql;
}

function apply_sql(string $db, string $sql): int
{
    $tmp = tempnam(sys_get_temp_dir(), 'gen_service_users_');
    if ($tmp === false || file_put_contents($tmp, $sql) === false) {
        fwrite(STDERR, 'gen-service-users: could not write the temporary SQL file' . PHP_EOL);
        return 1;
    }
    $root = getcwd();
    $ema = is_executable($root . '/vendor/bin/ema') ? $root . '/vendor/bin/ema' : 'ema';
    $cmd = 'DBUSER=root ' . escapeshellarg($ema) . ' mariadb ' . escapeshellarg($db) . ' < ' . escapeshellarg($tmp);
    passthru($cmd, $code);
    @unlink($tmp);
    return $code;
}

function main(array $argv): int
{
    $dbs = array();
    $dryRun = false;
    foreach (array_slice($argv, 1) as $arg) {
        if ($arg === '-n' || $arg === '--dry-run') {
            $dryRun = true;
        } elseif ($arg === '-h' || $arg === '--help') {
            fwrite(STDOUT, HELP);
            return 0;
        } elseif (str_starts_with($arg, '-')) {
            fwrite(STDERR, "gen-service-users: unknown flag: {$arg}" . PHP_EOL);
            return 1;
        } else {
            $dbs[] = $arg;
        }
    }

    $serviceFile = repo_file(SERVICE_USERS_FILE);
    if (!is_file($serviceFile)) {
        fwrite(STDERR, "gen-service-users: {$serviceFile} not found (run from the repo root)" . PHP_EOL);
        return 1;
    }

    $accounts = parse_accounts($serviceFile);
    $member = member_hosts(repo_file('etc/team.ini'));
    $worker = machine_tag_hosts(repo_file('etc/machines.ini'), 'worker');
    $web = machine_tag_hosts(repo_file('etc/machines.ini'), 'web');

    list($desiredByDb, $accountHosts) = build_desired($accounts, $member, $worker, $web);
    $allDbs = array_keys($desiredByDb);
    sort($allDbs);

    if ($dbs === array()) {
        $dbs = $allDbs;
    } else {
        $unknown = array_diff($dbs, $allDbs);
        if ($unknown !== array()) {
            fwrite(STDERR, 'gen-service-users: unknown database(s): ' . implode(', ', $unknown) . PHP_EOL);
            return 1;
        }
    }

    $scope = scope_accounts($accounts);

    $code = 0;
    foreach ($dbs as $db) {
        $existing = existing_users($db, $scope);
        $sql = build_sql($db, $desiredByDb[$db], $accountHosts, $existing);
        fwrite(STDOUT, $sql);
        if (!$dryRun) {
            $rc = apply_sql($db, $sql);
            if ($rc !== 0) {
                $code = $rc;
            }
        }
    }

    if ($dryRun) {
        fwrite(STDERR, 'gen-service-users: dry-run; SQL printed, not applied' . PHP_EOL);
    } elseif ($code === 0) {
        fwrite(STDOUT, 'gen-service-users: reconciled ' . implode(', ', $dbs) . '; reuter.ini keys are manual (not written)' . PHP_EOL);
    }
    return $code;
}

exit(main($argv));
