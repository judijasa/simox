#!/usr/bin/env bash
# fetch-private-data — materialize simox's private operational config into etc/
# as real files.
#
# The private config repo's committed content is the single source of truth: no
# machine runs on a loose, uncommitted copy. There is exactly one retrieval
# mechanism — the git-ignored `.private-source` pointer at the repo root, whose
# PRIVATE_DATA_GIT (+ optional PRIVATE_DATA_REF) is cloned/fetched on demand
# into the git-ignored var/private-data.
#
# The private repo's root layout is then COPIED into etc/ as real files, never
# symlinked, so a checkout carries its own operational data. `deploy.conf` is
# required: the deploy flow sources it, and a missing one fails the step.
# `reuter.ini` is expected (every DB-connecting host needs it) but its absence
# is not a materialization error — a no-database bootstrap legitimately has
# none; it is warned here and confirmed by the deploy wrapper before shipping.
# `dev.conf` is an optional override — its default is committed in
# etc/dev.default.conf, so a checkout works without the private copy and only a
# machine that diverges from the default needs one. `ema.conf` is the host-level
# override whose real ssl-ca/ssl-crl ship to prod (the committed
# etc/ema.default.conf carries only a generic fallback — the real host paths
# must never be committed).
# `machines.ini`, `team.ini`, `hosts` and `host-hardening.php` are copied only
# when the private source provides them. Copying is idempotent: etc/<file> is
# overwritten on every run, so a local edit to one of these files is lost — edit
# the private repo instead.
#
# An absent `.private-source` is a no-op (the repo stays fully functional on its
# committed templates); a present pointer that sets no PRIVATE_DATA_GIT is an
# error, not a silent skip.
#
# Prod hosts have neither git nor the pointer: they receive their runtime files
# (reuter.ini and ema.conf) from the deploy machine's deploy step instead — the
# framework's DEPLOY_PRIVATE_FILES ships them into the freshly swapped etc/ (an
# absent name is skipped and confirmed by the deploy wrapper; a no-database
# bootstrap ships no reuter.ini), while deploy.conf's values travel as replayed
# environment. dev.conf never leaves the dev machine.
# See doc/system/private-config.md.
#
# Usage: bin/fetch-private-data [target-dir]   (default: $PWD)

set -euo pipefail

ROOT="$(cd "${1:-$PWD}" && pwd)"
SOURCE_FILE="$ROOT/.private-source"

if [[ ! -f "$SOURCE_FILE" ]]; then
    echo "fetch-private-data: no $SOURCE_FILE — nothing to fetch (the repo stays on its committed templates)." >&2
    exit 0
fi

set -a
# shellcheck disable=SC1090
. "$SOURCE_FILE"
set +a

if [[ -z "${PRIVATE_DATA_GIT:-}" ]]; then
    echo "fetch-private-data: $SOURCE_FILE sets no PRIVATE_DATA_GIT (required)." >&2
    exit 1
fi

# Git is the only retrieval mechanism: refresh the on-demand checkout (or create
# it) and pin it to the configured ref.
SOURCE_DIR="$ROOT/var/private-data"
REF="${PRIVATE_DATA_REF:-main}"
if [[ -d "$SOURCE_DIR/.git" ]]; then
    git -C "$SOURCE_DIR" fetch --quiet origin "$REF"
    git -C "$SOURCE_DIR" checkout --quiet --detach FETCH_HEAD
else
    mkdir -p "$ROOT/var"
    git clone --quiet "$PRIVATE_DATA_GIT" "$SOURCE_DIR"
    git -C "$SOURCE_DIR" checkout --quiet --detach "$REF"
fi

# The tracked files, in the private repo's root layout: the required ones first
# (a missing one is a hard error), then the optional ones.
REQUIRED_FILES=(deploy.conf)
OPTIONAL_FILES=(dev.conf ema.conf machines.ini team.ini hosts host-hardening.php)

# copy_file <name> — install one private file into etc/. Returns 1 when the
# private source does not provide it (the caller decides whether that is fatal).
copy_file() {
    local f="$1" src="$SOURCE_DIR/$f"
    [[ -f "$src" ]] || return 1
    # Remove first: an injection by the older symlink mechanism left a link at
    # this path, and the real file must not be written through it.
    rm -f "$ROOT/etc/$f"
    install -m 0644 "$src" "$ROOT/etc/$f"
    copied="$copied $f"
    return 0
}

mkdir -p "$ROOT/etc"
copied=""
for f in "${REQUIRED_FILES[@]}"; do
    if ! copy_file "$f"; then
        echo "fetch-private-data: private source $SOURCE_DIR has no $f (required)." >&2
        exit 1
    fi
done
# reuter.ini is expected but not a hard prerequisite: a no-database bootstrap
# ships none. Warn here; the deploy wrapper confirms the absence before it
# ships (the framework skips an absent DEPLOY_PRIVATE_FILES name).
if ! copy_file reuter.ini; then
    echo "fetch-private-data: private source $SOURCE_DIR has no reuter.ini (no database provisioned yet — the deploy will confirm)." >&2
fi
for f in "${OPTIONAL_FILES[@]}"; do
    copy_file "$f" || true
done

echo "    Materialized into $ROOT/etc/:$copied"
