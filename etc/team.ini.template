; Team member registry — the source of the `member` host-pin set for the
; shared `simox` service account (see etc/service-users.sql). Copy to
; etc/team.ini (git-ignored) and fill it in — or keep it in a private config
; repo and inject it via .private-source (see doc/system/private-config.md).
;
; There is no longer one DB account per member: simox collapses the team onto
; a single shared writer account. bin/gen-service-users reads every IP value
; below (all keys except `subject`) as the `member` source and pins
; 'simox'@<ip> to it. Removing (or changing) an entry here revokes the stale
; pin on the next reconcile.
;
; `subject` is the member's client-certificate subject DN, used only for
; client-cert issuance (`gen-cert new <member>`) — it no longer pins a DB
; account. The CN is `<username>-<guid>` (a short random token) so
; same-named members stay distinct and a leaked cert is rotated by issuing a
; new cert with a new guid.
;
;   `gen-cert new <member>` reads the `subject` below for the CSR.
;   `init-local-env.sh` finds the section whose entries include the local
;   `hostname` and exports its name as DBUSER.

[john]
subject          = /CN=john-a1b2c3d4/O=team
john-workstation = 10.147.x.20
john-laptop      = 10.147.x.21

[jane]
subject          = /CN=jane-9f8e7d6c/O=team
jane-workstation = 10.147.x.30
