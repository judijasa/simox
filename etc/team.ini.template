; Team member registry — the `member` host-pin source for the shared `simox`
; service account (mapped to the `simox_member` role in pkg/roles-<GUID>).
; This file is private data, kept in the private config repo and copied into
; etc/ as a real file by simox's bin/fetch-private-data via .private-source
; (see doc/system/private-config.md).
;
; One section per member, and no credential: simox collapses the team onto a
; single shared writer account, so there is no per-member DB account and no
; `password` key. The framework gen-service-accounts reads every
; `hostname = ZeroTier IP` entry below as the `member` source and pins
; 'simox'@<ip> to the `simox_member` role (ALL on simo0, SELECT on simo1).
; Removing (or changing) an entry here revokes the stale pin on the next
; reconcile.
;
; The same entries are what `gen-cert` matches this machine's own local IPv4
; against to derive its client certificate's CN (see
; doc/system/machine-certs.md) — the CN is the machine's pinned name here.
; There is no `subject` key: REQUIRE X509 is a membership gate, not a subject
; match, so a member's certificate is issued per machine, not per member.
;
;   `gen-cert` reads the entry matching this machine's IP for the CSR's CN.

[john]
john-workstation = 10.147.x.20
john-laptop      = 10.147.x.21

[jane]
jane-workstation = 10.147.x.30
