# Production runtime configuration template (committed).
#
# Regenerated into .env (git-ignored) on every deploy by the framework
# `gen-env` CLI; this file is the data behind that mechanism. The deployed
# repo directory is replaced on each deploy, so .env must be recreated
# before cron is installed — cron runs `phprun` from the repo root and a
# missing key would silently fall back to the framework defaults (e.g.
# EMA_TARGET=local -> wrong DB section in production).
#
# Values must match the equivalent deploy-time paths in etc/deploy.conf:
# REPO_PATH  = DEPLOY_TARGET_DIR, REPO_LOG = DEPLOY_LOG_DIR, MYSQL_* are
# derived from DEPLOY_DB_BASE (data, mysql.sock, mysql.pid).
export REPO_PATH=/srv/apps/simox
export REPO_LOG=/var/log/simox
export REUTER_INI=/etc/simox/reuter.ini
export MYSQL_DATA_DIR=/var/lib/simox/mariadb/data
export MYSQL_UNIX_PORT=/var/lib/simox/mariadb/mysql.sock
export MYSQL_PID_FILE=/var/lib/simox/mariadb/mysql.pid
export EMA_TARGET=prod
