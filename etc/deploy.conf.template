# Deploy configuration template (committed; mirrors the current production
# settings). The real etc/deploy.conf is private data on the deploy machine:
# bin/fetch-private-data copies it into etc/ in dev, and the framework sources
# it locally and replays its environment to every remote step, so the host
# never holds a copy of this file. Copy this template into place only to run
# without private data — bin/fetch-private-data overwrites etc/deploy.conf on
# every run, so change settings in the private repo, never in this file.
# `deploy` requires it at the repo root and fails loudly if missing.
#
# .env (generated, git-ignored) holds machine settings; this file holds the
# deployment target shared by every machine of the project.
#
# `gen-env` (run on the remote by the framework deploy on every deploy)
# projects the git-ignored .env from THIS file's replayed environment — there
# is no separate etc/env.prod anymore. The projection:
#   REPO_PATH      := DEPLOY_TARGET_DIR
#   REPO_LOG       := DEPLOY_LOG_DIR
#   REUTER_INI     := DEPLOY_REUTER_INI
#   SSL_DIR        := DEPLOY_SSL_DIR (optional — the client-cert directory)
#   EMA_TARGET     := prod (constant)
#
# .env stays MYSQL_*-free: the socket lives in
# the prod reuter.ini section (MYSQL_UNIX_PORT, recorded from `ema create`
# output). The app layer stays TCP-only. SSL_DIR (optional) is the one
# non-MYSQL transport key: the directory holding the host's TLS client
# certificate for the `require: 'X509'` service account (see
# doc/system/machine-certs.md).
#
# PROD_USER: unprivileged app user on the remote host. Must exist with SSH
# access before the first deploy (see doc/system/deploy.md).
export PROD_USER=simox

# DEPLOY_TARGET_DIR: remote repo location.
export DEPLOY_TARGET_DIR=/srv/apps/simox

# DEPLOY_LOG_DIR: remote log dir (deploy_version.log lives here).
export DEPLOY_LOG_DIR=/var/log/simox

# DEPLOY_PHP_FPM_RUN: base path for the nix-built php-fpm pool's pid file and
# FastCGI socket — the pool renders `pid`/`listen` as `@PHP_FPM_RUN@.pid` /
# `@PHP_FPM_RUN@.sock`, and the consumer's Apache vhost proxies to the same
# socket, so keep the two in sync from this one value. It is a host-local
# runtime convention under /run (tmpfs), not a secret; it lives here so both
# sides render from a single source.
export DEPLOY_PHP_FPM_RUN=/run/php-fpm-simox

# DEPLOY_REUTER_INI: path to the consumer's manual reuter.ini — one
# [<instance>] section per instance (`simo0` primary and `simo1` read-only
# replica, both serving the `simo` schema; SERVER/PORT/MYSQL_UNIX_PORT/DBNAME,
# plus an optional SIMOX_PASSWORD key),
# recorded from `ema create`'s output. Service accounts are reconciled by the
# framework gen-service-accounts against the shared pkg/roles-<GUID>
# declaration, not provisioned here. gen-env writes it into .env
# as REUTER_INI; deploy's db-check reads it to verify reachability. The
# file itself is private data, shipped into etc/ by the framework's
# DEPLOY_PRIVATE_FILES (see below).
export DEPLOY_REUTER_INI=/srv/apps/simox/etc/reuter.ini

# DEPLOY_SSL_DIR: directory on the host holding the app layer's TLS client
# certificate (client.crt + client.key) for the `require: 'X509'` service
# account. gen-env writes it into .env as SSL_DIR and the app layer derives its
# client.crt/client.key paths from it; the php-fpm pool carries the same value
# as env[SSL_DIR] (the web process has no .env). The cert material itself is
# provisioned out of band on the host — it is a private key, never shipped by
# the deploy, and only the public cert travels back from the CA. See
# doc/system/machine-certs.md.
export DEPLOY_SSL_DIR=/etc/<app>/ssl

# DEPLOY_PRIVATE_FILES: space-separated etc/-relative private file names the
# framework ships from the deploy machine's etc/ into the freshly swapped
# etc/ on the host (whole, verbatim). `reuter.ini` is the expected baseline —
# every DB-connecting host needs it; deploy.conf itself is NOT shipped (its
# values travel as replayed environment). `ema.conf` ships too: the committed
# etc/ema.default.conf carries only a generic ssl-ca/ssl-crl fallback (the real
# host paths must never be committed), so the real value travels in the
# git-ignored override etc/ema.conf. The ship step skips any name absent from
# etc/ (materialized from the private repo by bin/fetch-private-data);
# deploy asks the operator to confirm such an absence (a no-database
# bootstrap ships no reuter.ini) before handing off to the framework.
export DEPLOY_PRIVATE_FILES="reuter.ini ema.conf"

# DEPLOY_NIX_RESULT_DIR: remote nix result parent.
export DEPLOY_NIX_RESULT_DIR=/usr/local/simox

# DEPLOY_NIX_GCROOT: remote nix gcroot.
export DEPLOY_NIX_GCROOT=/nix/var/nix/gcroots/simox

# DEPLOY_INIT_CMD: consumer-specific provisioning extras run over SSH by `deploy`
# AFTER the framework's bin/pf-provision.sh and BEFORE other deploy
# steps, with this file's environment replayed. Skipped if unset.
export DEPLOY_INIT_CMD="bash bin/deploy-steps/provision-extra.sh"

# CRON_FILE: remote crontab file the framework `cron-manifest` output is
# installed to by deploy's built-in server step on every host (filtered by
# that host's tags — a job runs only where its `scope` matches, and
# `host`-scoped jobs run everywhere). REQUIRED whenever the repo declares a
# `#[CronJob]` attribute (deploy fails loudly if unset then); unused when
# the repo declares no cron jobs.
export CRON_FILE=/etc/cron.d/simo-orchestrator

# CRON_USER: user the cron entries run as.
export CRON_USER=root
