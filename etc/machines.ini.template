# Machine registry: prod machines only.
# Copy to etc/machines.ini (git-ignored; commit it only in a private fork) and
# fill in your entries. `pf-deploy.sh` (the framework CLI wrapped by
# bin/deploy.sh) and `gen-reuter` read the [prod] roster; the dev-machine
# `DBUSER` mapping now lives in etc/team.ini (see etc/team.ini.template), not
# here.
#
# [prod] prod deploy targets. Each key is the server's ZeroTier IP (the same
#        address `pf-deploy.sh` uses for SSH). The value is a comma-separated
#        list of `tag[:name]` tokens:
#          bare tag    `web`      -> boolean flag (a deploy step on this host)
#          named tag   `db:simo`  -> a `db` resource named `simo`
#        `db` is the framework's built-in tag (a MariaDB instance +
#        `gen-reuter` connectivity); every other tag is consumer-owned:
#          `web`     restore Apache www-data traversal on the repo dir
#          `worker`  install the cron-manifest output (cron jobs)
#        A host with a `db:<name>` token is a database host; an empty value is
#        a code-only server (it deploys the codebase but runs no tagged step).
#
#        Constraint: a named token may appear on exactly ONE server
#        (`db:simo` and `web` are independent). Bare flags carry no name,
#        hence no uniqueness constraint. A server may host no database
#        (code-only), one database, or several databases in its MariaDB
#        instance.

[prod]
# 10.147.x.10=db:simo, db:analytics, web, worker
