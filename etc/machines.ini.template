# Machine registry: prod machines only.
# Copy to etc/machines.ini (git-ignored; commit it only in a private fork) and
# fill in your entries — or keep it in a private config repo and inject it via
# .private-source (see doc/system/private-config.md). `pf-deploy.sh` (the
# framework CLI wrapped by bin/deploy.sh) and `db-check` read the [prod]
# roster; the dev-machine `DBUSER` mapping now lives in etc/team.ini (see
# etc/team.ini.template), not here.
#
# [prod] prod deploy targets. Each key is the server's ZeroTier IP (the same
#        address `pf-deploy.sh` uses for SSH). The value is a comma-separated
#        list of `tag[:name]` tokens:
#          named tag   `db:simo0` -> a `db` resource named `simo0`
#          bare tag    `worker`   -> boolean flag (install cron on this host)
#        `db` (named) and `worker` (bare) are the framework's built-in tags:
#        a `db:<name>` token is the advisory anchor for `db-check` (it
#        verifies that database exists and is reachable on its host — the
#        instance itself is provisioned by `ema create`, not by deploy);
#        `worker` installs the `cron-manifest` output (cron jobs) on every
#        deploy. Every other tag is consumer-owned:
#          `web`     restore Apache www-data traversal on the repo dir
#        A host with a `db:<name>` token is a database host; a bare `worker`
#        token adds cron install on that host; an empty value is a code-only
#        server (it deploys the codebase but runs no tagged step).
#
#        Service-account pins (bin/gen-service-users derives the single
#        `simox` host-pin set from the `worker` tag plus etc/team.ini, never
#        from a hardcoded map). `web` feeds no account pin: it is only the
#        Apache-traversal deploy step tag. See etc/service-users.sql for the
#        account -> source mapping.
#
#        Constraint: a named token may appear on exactly ONE server
#        (`db:simo0` and `db:simo1` are independent databases; `web` is
#        independent of both). Bare flags carry no name, hence no uniqueness
#        constraint. A server may host no database (code-only), one database,
#        or several databases (one MariaDB instance each, created by
#        `ema create`).

[prod]
# 10.147.x.10=db:simo0, worker
# 10.147.x.11=db:simo1, web
