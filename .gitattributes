# Production deploy exclusions: the framework `deploy` CLI ships the repo via
# `git archive`, which honors `export-ignore`. These paths are omitted from
# the deployed tarball while remaining present in dev checkouts. Everything
# the remote needs at runtime (composer.json/lock, src/, public/, pkg/, srv/,
# etc/, bin/deploy/ hooks, LICENSE, README.md) stays in the archive.

# Linting and git tooling
/.pre-commit-config.yaml export-ignore
/phpstan.dist.neon export-ignore
/hooks/ export-ignore
/.gitignore export-ignore

# Dev-only build and environment plumbing
/Makefile export-ignore
/bin/dev/ export-ignore
/flake.nix export-ignore
/flake.lock export-ignore

# Scratch and documentation
/doc/ export-ignore

# Dev machine templates (prod reads /etc/..., not these)
/etc/hosts.template export-ignore
/etc/dev-machines.ini.template export-ignore
/etc/reuter.ini.template export-ignore
