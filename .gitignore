# Ignore all .log files
*.log
*.swp

# Ignore directories
# mydir/ ignores mydir dirs at any dir level,
# while /mydir/ ignores only mydir dir at repo root-level (not at system-level).
/vendor/
/var/
# Nix build output. `nix build` creates `result` as a symlink, so no trailing
# slash here: a `/result/` rule would only match real directories and leave
# the symlink untracked. `result-*` covers repeated/multi-output builds.
/result
/result-*

# Ignore files
/etc/deploy.conf
/etc/reuter.ini
/etc/machines.ini
/etc/team.ini
/etc/hosts
/etc/host-hardening.php
.env
.private-source
.phpstan-result-cache.php
